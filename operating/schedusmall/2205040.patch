 // Give up the CPU for one scheduling round.
+// yield() is called on every timer tick — it is always a
+// timer-driven preemption, never a voluntary yield.
 void
 yield(void)
 {
   struct proc *p = myproc();
   acquire(&p->lock);
+
+  p->ticks_consumed++;
+  p->queue_ticks[p->inQ]++;
+
+  if(p->inQ == 0) {
+    if(p->ticks_consumed >= TIME_LIMIT_0) {
+      // Used full time slice -> Demote to Queue 1
+      p->inQ = 1;
+      p->running_time++;
+      if(print_logs) {
+        printf("\033[0;31mDEMO: Process %d (%s) ran for %d time ticks, demoted to queue 1\033[0m\n",
+               p->pid, p->name, p->ticks_consumed);
+      }
+      p->ticks_consumed = 0;
+    }
+    // else: time slice not exhausted, do nothing — scheduler will
+    // resume this process on the next iteration.
+  } else if(p->inQ == 1) {
+    if(p->ticks_consumed >= TIME_LIMIT_1) {
+      // Exhausted Q1 time slice -> Remain in Queue 1
+      p->running_time++;
+      p->ticks_consumed = 0;
+    }
+    // else: Q1 time slice not exhausted, do nothing.
+  }
+
   p->state = RUNNABLE;
   sched();
   release(&p->lock);
@@ -552,6 +706,22 @@ sleep(void *chan, struct spinlock *lk)
   acquire(&p->lock);  //DOC: sleeplock1
   release(lk);
 
+  // Voluntary yield: process is giving up the CPU before its
+  // time slice is exhausted (e.g. waiting for I/O).
+  // Promote it one level up if applicable.
+  if(p->ticks_consumed > 0) {
+    if(p->inQ == 1 && p->ticks_consumed < TIME_LIMIT_1) {
+      // In Queue 1, hasn't used full slice -> promote to Queue 0
+      p->inQ = 0;
+      if(print_logs) {
+        printf("\033[0;34mPROMO: Process %d (%s) ran for %d time ticks, promoted to queue 0\033[0m\n",
+               p->pid, p->name, p->ticks_consumed);
+      }
+    }
+    // Reset ticks_consumed since the process is giving up the CPU
+    p->ticks_consumed = 0;
+  }
+
