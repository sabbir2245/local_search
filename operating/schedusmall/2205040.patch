+
+uint64
+sys_settickets(void)
+{
+  int number;
+  argint(0, &number);
+
+  struct proc *p = myproc();
+
+  if(number < 1) {
+    p->tickets_original = DEFAULT_TICKETS;
+    p->tickets_current = DEFAULT_TICKETS;
+    return -1;
+  }
+
+  p->tickets_original = number;
+  p->tickets_current = number;
+  return 0;
+}
+
+uint64
+sys_getpinfo(void)
+{
+  uint64 addr;
+  argaddr(0, &addr);
+
+  struct pstat st;
+  struct proc *p;
+
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    st.pid[p - proc] = p->pid;
+    st.inuse[p - proc] = (p->state != UNUSED) ? 1 : 0;
+    st.inQ[p - proc] = p->inQ;
+    st.waiting_time[p - proc] = p->waiting_time;
+    st.running_time[p - proc] = p->running_time;
+    st.times_scheduled[p - proc] = p->times_scheduled;
+    st.tickets_original[p - proc] = p->tickets_original;
+    st.tickets_current[p - proc] = p->tickets_current;
+    st.queue_ticks[p - proc][0] = p->queue_ticks[0];
+    st.queue_ticks[p - proc][1] = p->queue_ticks[1];
+    release(&p->lock);
+  }
+
+  struct proc *curproc = myproc();
+  if(copyout(curproc->pagetable, addr, (char *)&st, sizeof(st)) < 0)
+    return -1;
+
+  return 0;
+}
